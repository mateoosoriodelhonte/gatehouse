<span class="status-badge status-@Status.ToString().ToLowerInvariant()">
    <span class="status-mark" aria-hidden="true">@Mark</span>
    <span>@Status.ToString().ToUpperInvariant()</span>
</span>

@code {
    [Parameter, EditorRequired]
    public ReadinessStatus Status { get; set; }

    private string Mark => Status switch
    {
        ReadinessStatus.Go => "✓",
        ReadinessStatus.Review => "◷",
        ReadinessStatus.Blocked => "!",
        ReadinessStatus.Draft => "◇",
        _ => "?",
    };
}
