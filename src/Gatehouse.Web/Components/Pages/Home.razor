@page "/"
@inject GatehouseUiService Gatehouse
@inject NavigationManager Navigation

<PageTitle>Gatehouse</PageTitle>

<p class="loading-line" role="status">Opening Gatehouse…</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        var repositories = await Gatehouse.ListRepositoriesAsync();
        var selected = repositories.FirstOrDefault(item => item.IsSelected);
        Navigation.NavigateTo(selected is null
            ? "/repositories"
            : $"/repositories/{selected.Id}/overview");
    }
}
