{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Gatehouse": {
    "Port": 5341,
    "FreshnessMinutes": 15,
    "RetentionDays": 30,
    "MaxSnapshotsPerPullRequest": 50
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
